# Copy to .env.local for local dev, and add the same values in Vercel > Settings > Environment Variables.
# Leave both empty to run in DEMO MODE with sample data (no login).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed on your machine for `npm run seed`. Never add this to Vercel or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Allowed sign-in domain
NEXT_PUBLIC_ALLOWED_DOMAIN=uncvrd.com
